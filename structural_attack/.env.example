# TradingAgents Attack Framework - Environment Variables
# Copy this file to .env and fill in your actual API keys
# Usage: cp .env.example .env

# ===== Required =====

# OpenAI API Key (for GPT models)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===== Optional (depending on data vendor config) =====

# Alpha Vantage API Key (for stock/fundamental data)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key-here

# Anthropic API Key (if using Claude models via langchain-anthropic)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google API Key (if using Gemini models via langchain-google-genai)
# GOOGLE_API_KEY=your-google-api-key-here

# ===== Advanced Settings =====

# Custom results directory (optional)
# TRADINGAGENTS_RESULTS_DIR=./results

# Redis URL (if using redis for caching)
# REDIS_URL=redis://localhost:6379
